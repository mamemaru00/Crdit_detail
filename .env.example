# Flask設定
# development（開発環境、デバッグ有効）または production（本番環境、デバッグ無効）
# Docker環境では production を推奨
FLASK_ENV=production
# REQUIRED: ランダムな64文字以上の文字列を設定してください
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-change-me

# Google Sheets設定
# REQUIRED: Google SheetsのスプレッドシートIDを設定してください
SPREADSHEET_ID=your-spreadsheet-id-here

# アプリケーション設定
DEFAULT_YEAR=2025
LOG_LEVEL=INFO

# CSV設定（オプション）
# CSVファイルの最大サイズをバイト単位で指定（デフォルト: 52428800 = 50MB）
# CSV_MAX_FILE_SIZE=104857600  # 100MBに変更する場合

# セッション設定（オプション）
# セッションの有効期限（秒単位、デフォルト: 1800 = 30分）
# SESSION_TTL_SECONDS=3600  # 60分に変更する場合
# セッションクリーンアップの実行間隔（時間単位、デフォルト: 6時間）
# SESSION_CLEANUP_INTERVAL_HOURS=12  # 12時間に変更する場合
