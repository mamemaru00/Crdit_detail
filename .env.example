# ==========================================
# イオンカード明細取込システム - 環境変数テンプレート
# ==========================================
# このファイルをコピーして .env ファイルを作成してください。
# .env ファイルは .gitignore で管理対象外です。
# ==========================================

# ------------------------------------------
# OpenAI API設定（ChatGPT分類機能 v2.0）
# ------------------------------------------
# OpenAI API キー（https://platform.openai.com/api-keys で取得）
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するGPTモデル（デフォルト: gpt-5）
GPT_MODEL=gpt-5

# 最大トークン数（デフォルト: 2000）
GPT_MAX_TOKENS=2000

# Temperature設定（デフォルト: 0.3、範囲: 0.0-2.0）
GPT_TEMPERATURE=0.3

# バッチサイズ（デフォルト: 50）
GPT_BATCH_SIZE=10

# ------------------------------------------
# Flask設定
# ------------------------------------------
# Flask Secret Key（64文字以上のランダム文字列を推奨）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-random-64-character-string-please-generate-new-one

# ------------------------------------------
# Google Sheets設定
# ------------------------------------------
# Googleスプレッドシート ID（スプレッドシートのURLから取得）
# URL例: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=1234567890abcdefghijklmnopqrstuvwxyzABCDEF

# ------------------------------------------
# アプリケーション設定
# ------------------------------------------
# デフォルト年（処理対象のデフォルト年度）
DEFAULT_YEAR=2025

# ログレベル（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# セッション有効期限（秒単位、デフォルト: 1800秒 = 30分）
SESSION_TTL_SECONDS=1800

# ------------------------------------------
# セキュリティ設定
# ------------------------------------------
# CSVファイルサイズ上限（バイト単位）
# デフォルト: 10MB (10485760 bytes)
# 本番推奨: 10MB（セキュリティ重視）
# テスト用: 20MB (20971520 bytes)
CSV_MAX_FILE_SIZE=10485760

# ------------------------------------------
# 注意事項
# ------------------------------------------
# 1. このファイルを .env にコピーして使用してください
# 2. .env ファイルは絶対にGitにコミットしないでください
# 3. 本番環境では強力なSECRET_KEYを生成してください
# 4. OpenAI API キーは定期的にローテーションしてください
# 5. サービスアカウント認証情報は config/service_account.json に配置してください
