# イオンカード明細取込システム - 環境変数テンプレート
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください

# ==================== Flask設定 ====================
# セキュリティキー（本番環境では必ず変更すること）
SECRET_KEY=dev-secret-key-change-in-production

# 環境（development / production / testing）
FLASK_ENV=development

# ==================== Google Sheets API設定 ====================
# スプレッドシートID（Google SheetsのURLから取得）
# 例: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# ==================== OpenAI API設定（v2.0 ChatGPT分類機能） ====================
# OpenAI APIキー（https://platform.openai.com/api-keys で取得）
# 注意: このキーは絶対にGitにコミットしないこと！
OPENAI_API_KEY=sk-proj-your-api-key-here

# 使用するGPTモデル（デフォルト: gpt-5）
GPT_MODEL=gpt-5

# 最大トークン数（デフォルト: 2000）
GPT_MAX_TOKENS=2000

# 温度パラメータ（0.0～1.0、低いほど決定論的、デフォルト: 0.3）
GPT_TEMPERATURE=0.3

# バッチサイズ（1リクエストあたりの最大店舗数、デフォルト: 50）
GPT_BATCH_SIZE=50

# ==================== セッション設定 ====================
# セッション有効期限（秒単位、デフォルト: 1800 = 30分）
SESSION_TTL_SECONDS=1800

# セッションクリーンアップ間隔（時間単位、デフォルト: 6時間）
SESSION_CLEANUP_INTERVAL_HOURS=6

# ==================== CSVファイル設定 ====================
# CSVファイルサイズ上限（バイト単位、デフォルト: 10MB = 10485760）
# テスト環境: 20MB (20971520)
# 本番環境: 10MB (10485760) 推奨
CSV_MAX_FILE_SIZE=10485760

# ==================== デフォルト設定 ====================
# デフォルト年（CSVに年情報がない場合の代替値）
DEFAULT_YEAR=2025

# ==================== ログ設定 ====================
# ログレベル（DEBUG / INFO / WARNING / ERROR / CRITICAL）
LOG_LEVEL=INFO

# ==================== セキュリティ注意事項 ====================
# 1. .envファイルは .gitignore に含まれています（コミット防止）
# 2. OPENAI_API_KEY は絶対に外部に漏らさないこと
# 3. 本番環境では SECRET_KEY を必ず変更すること
# 4. config/service_account.json も Git管理対象外です
